# ==========================================================================
# Backend (NestJS + Prisma). Copie para backend/.env e ajuste.
# Lido pelo ConfigModule do Nest e pela CLI do Prisma.
# ==========================================================================

# Conexão com o Postgres (que roda no docker-compose da raiz).
# DATABASE_URL = owner (superuser) — usada por migrations e seed (bypassa RLS).
DATABASE_URL="postgresql://restaurante:restaurante@localhost:5432/restaurante_saas?schema=public"

# APP_DATABASE_URL = usuário da aplicação (app_user), SEM superuser — sujeito ao
# RLS. O backend em runtime conecta com esta. Criado na migration da Fase 2.
APP_DATABASE_URL="postgresql://app_user:app_user_pw@localhost:5432/restaurante_saas?schema=public"

# Servidor
BACKEND_PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=troque-este-segredo-de-access
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Estabelecimento fixo da Fase 1
DEFAULT_ESTABLISHMENT_SLUG=meu-restaurante

# Focus NFe (Bloco 12 — token real fica na tabela FiscalCredential, não aqui)
FOCUS_NFE_ENV=homologacao
FOCUS_NFE_BASE_URL_HOMOLOGACAO=https://homologacao.focusnfe.com.br
FOCUS_NFE_BASE_URL_PRODUCAO=https://api.focusnfe.com.br

# ==========================================================================
# Produção (EasyPanel) — ver DEPLOY.md na raiz do repo para o passo a passo.
# ==========================================================================
# - NODE_ENV=production
# - DATABASE_URL: superusuário do Postgres gerenciado do EasyPanel (roda
#   migrations e cria o role app_user). NÃO é o usado pela aplicação.
# - APP_DATABASE_URL: usuário app_user, com senha FORTE escolhida por você
#   (não use "app_user_pw" — é a senha de dev, exposta no GitHub). No boot
#   do container, o entrypoint lê a senha daqui e sincroniza o role no
#   banco automaticamente (ver backend/scripts/sync-app-user-password.js).
# - JWT_ACCESS_SECRET / JWT_REFRESH_SECRET: gere valores novos e longos,
#   por exemplo com `openssl rand -base64 48`. Nunca reuse os de dev.
# - CORS_ORIGIN: domínio público do frontend (https://...). Aceita vários
#   separados por vírgula, ex: "https://app.com,https://www.app.com".
