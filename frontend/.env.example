# Só usadas em produção (build). Em dev deixe tudo vazio/comentado: o
# proxy do Vite (vite.config.ts) encaminha /api e /socket.io pro backend
# local automaticamente.
#
# O Vite embute essas variáveis NO BUILD, não no runtime — no EasyPanel
# elas entram como "Build Args" do serviço frontend, não como env comum.

# URL pública do backend (sem barra no final).
# VITE_API_URL=https://api.seudominio.com

# Normalmente igual à VITE_API_URL. Só diferente se o socket.io estiver
# atrás de outro host/porta.
# VITE_SOCKET_URL=https://api.seudominio.com
